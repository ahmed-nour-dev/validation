{
    "name": "ahmednour/validation",
    "description": "Fast compiled PHP validation library: Laravel-compatible rule strings, native code generation and streaming for large datasets.",
    "keywords": ["validation", "validator", "fast", "compiled", "laravel", "performance", "streaming", "octane"],
    "homepage": "https://github.com/ahmed-nour-dev/validation",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "illuminate/validation": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Vi\\Validation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vi\\Validation\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "symfony/uid": "^6.0|^7.0"
    },

    "extra": {
        "laravel": {
            "providers": [
                "Vi\\Validation\\Laravel\\FastValidationServiceProvider"
            ],
            "aliases": {
                "FastValidator": "Vi\\Validation\\Laravel\\Facades\\FastValidator"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
